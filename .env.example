# ==============================================================================
# Eden — environment variables
#
# Copy this file to `.env.local` for local development, and set the same keys in
# your Vercel project settings for deployment (Project → Settings → Environment
# Variables). Every variable is OPTIONAL: Eden builds and boots with none of
# them set. A capability simply stays disabled until its variables are present,
# and any endpoint that needs a missing one fails with a clear configuration
# error rather than guessing.
#
# See docs/ENVIRONMENT.md for what each value is and where to find it.
# ==============================================================================

# ----- Supabase (database + auth) ---------------------------------------------
# Public values: safe to expose to the browser (the NEXT_PUBLIC_ prefix ships
# them to the client). Find both in Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Bypasses row-level security; NEVER expose to the browser
# and never commit a real value. Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# ----- Reasoning provider (AI) ------------------------------------------------
# Server-only. The reasoning layer is provider-agnostic; OpenAI is the first
# concrete provider. Get a key at https://platform.openai.com/api-keys.
OPENAI_API_KEY=
# Optional: override the default model (defaults to gpt-4o-mini).
OPENAI_MODEL=

# Optional: which registered reasoning provider to use (defaults to "openai").
EDEN_REASONING_PROVIDER=

# ----- Place search (restaurant/venue finding tool) ---------------------------
# Server-only. Eden's first real Execution tool finds places near a location.
# Geoapify is the default provider; free tier, no card to start: https://myprojects.geoapify.com
GEOAPIFY_API_KEY=
# Optional: which registered places provider to use (defaults to "geoapify").
EDEN_PLACES_PROVIDER=
# Optional but recommended: fallback location used when a request names no place,
# e.g. "Christchurch, New Zealand". Lets requests like "Italian dinner tonight" work directly.
EDEN_DEFAULT_LOCATION=

# ----- Voice (text-to-speech) -------------------------------------------------
# Server-only. Eden speaks its replies via ElevenLabs. Get a key at https://elevenlabs.io
ELEVENLABS_API_KEY=
# Optional: voice id (defaults to ElevenLabs' "Rachel"). Pick one in your ElevenLabs voice library.
ELEVENLABS_VOICE_ID=
# Optional: model id (defaults to eleven_turbo_v2_5).
ELEVENLABS_MODEL=
# Optional: which registered speech provider to use (defaults to "elevenlabs").
EDEN_SPEECH_PROVIDER=

# ----- Logging ----------------------------------------------------------------
# Optional: one of debug | info | warn | error (defaults to info).
EDEN_LOG_LEVEL=
